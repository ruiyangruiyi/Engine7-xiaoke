@app.get("/api/avatars")
async def get_avatars():
    """列出可用的 avatar 图片 — 本地 selfie + 235 端 (代理)"""
    import glob as _glob
    # 本地 selfie 目录
    selfie_dir = args.selfie_dir or os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "..", "xiaoke", "workspace", "selfie")
    local_images = []
    if os.path.isdir(selfie_dir):
        for f in os.listdir(selfie_dir):
            if f.lower().endswith(('.jpg', '.jpeg', '.png')):
                local_images.append(f)
    # 235 端形象列表 — avatar=none 时跳过 SSH
    remote_avatars = []
    remote_current = None
    if _runtime_config["avatar_provider"] not in ("none", "", None):
      try:
        from avatar.autodl_avatar import get_ssh
        ssh = get_ssh()
        if ssh:
            si, so, se = ssh.exec_command("curl -s -m 5 http://localhost:8899/api/avatar", timeout=5)
            raw = so.read().decode().strip()
            if raw:
                import json as _j2
                data = _j2.loads(raw)
                remote_avatars = data.get("avatars", [])
                remote_current = data.get("current")
      except Exception as e:
        print(f"[avatars] 235 list failed: {e}")
    return JSONResponse({
        "local": local_images,
        "remote": remote_avatars,
        "current": remote_current or _runtime_config["avatar_image"],
    })


@app.post("/api/avatar/switch")
async def switch_avatar(request: Request):
    """切换 FlashHead 形象 — 调 235 /api/avatar."""
    body = await request.json()
    image = body.get("image")
    if not image:
        return JSONResponse({"ok": False, "error": "Missing 'image'"})
    try:
        from avatar.autodl_avatar import get_ssh
        ssh = get_ssh()
        if not ssh:
            return JSONResponse({"ok": False, "error": "SSH not connected"})
        import json as _j3
        payload = _j3.dumps({"image": image})
        cmd = f"curl -sm 30 -X POST http://localhost:8899/api/avatar -H 'Content-Type: application/json' -d '{payload}'"
        si, so, se = ssh.exec_command(cmd, timeout=30)
        raw = so.read().decode().strip()
        if raw:
            result = _j3.loads(raw)
            print(f"[avatar-switch] 235 response: {result}")
            if result.get("ok"):
                _runtime_config["avatar_image"] = result.get("current", image)
                _save_config()
            return JSONResponse(result)
        return JSONResponse({"ok": False, "error": "No response from 235"})
    except Exception as e:
        print(f"[avatar-switch] Failed: {e}")
        return JSONResponse({"ok": False, "error": str(e)})

@app.post("/api/pull/start")
async def pull_start():
    """启动 Carpo pull（按需）"""
    global _carpo_pull_started
    print(f"[pull_start] called, _carpo_pull_started={_carpo_pull_started}, _carpo_puller={_carpo_puller}", flush=True)
    if _carpo_pull_started:
        print("[pull_start] already running, skip", flush=True)
        return JSONResponse({"ok": True, "already_running": True})
    try:
        print("[pull_start] calling _init_carpo_pull()", flush=True)
        _init_carpo_pull()
        print(f"[pull_start] after init, puller={_carpo_puller}, calling start()", flush=True)
        if _carpo_puller is not None:
            _carpo_puller.start()
        _carpo_pull_started = True
        print("[pull_start] started, broadcasting", flush=True)
        await _broadcast({"type": "pull_status", "pulling": True})
        return JSONResponse({"ok": True, "pulling": True})
    except Exception as e:
        return JSONResponse({"ok": False, "error": str(e)}, status_code=500)

@app.post("/api/pull/stop")
async def pull_stop():
    """停止 Carpo pull"""
    global _carpo_pull_started, _carpo_puller, _carpo_lib
    if not _carpo_pull_started:
        return JSONResponse({"ok": True, "already_stopped": True})
    try:
        if _carpo_puller:
            _carpo_puller.stop()
            _carpo_puller = None
        if _carpo_lib:
            _carpo_lib = None
        _carpo_pull_started = False
        await _broadcast({"type": "pull_status", "pulling": False})
        return JSONResponse({"ok": True, "pulling": False})
    except Exception as e:
        return JSONResponse({"ok": False, "error": str(e)}, status_code=500)

@app.get("/api/pull/status")
async def pull_status():
    return JSONResponse({"pulling": _carpo_pull_started, "mode": _runtime_config["pull_mode"]})


# === 调试录制（A-V 同步诊断）—— 方案 B 终版：直接写原始流，stop 后 ffmpeg mux ===
# video: H.264 NAL bytes → .h264 (零 CPU 负担)
# audio: Opus decode → PCM int16 → .wav (解码很轻)
# stop: ffmpeg 一次性 mux 成 mp4
_record_active = False
_record_output_mp4 = None
_record_video_fp = None       # .h264 文件 handle
_record_video_path = None
_record_audio_fp = None       # .wav 文件 handle
_record_audio_wav = None
_record_video_count = 0
_record_audio_count = 0
_record_started_ts = None
_record_video_first_pts = None
_record_audio_first_pts = None
_record_audio_sr = 48000


def _start_record(duration=10):
    """启动录制：直接写 H.264 NAL + Opus→PCM wav，stop 后 ffmpeg mux"""
    global _record_active, _record_output_mp4
    global _record_video_fp, _record_video_path
    global _record_audio_fp, _record_audio_wav
    global _record_video_count, _record_audio_count, _record_started_ts
    global _record_video_first_pts, _record_audio_first_pts
    import time as _t, wave as _wave
    if _record_active:
        return None, "recording already in progress"
    ts = _t.strftime('%Y%m%d_%H%M%S')
    output_mp4 = f"D:/xiaoke/logs/carpo_record_{ts}.mp4"
    video_path = output_mp4.replace(".mp4", ".h264")
    audio_wav = output_mp4.replace(".mp4", "_audio.wav")
    emit_audio_wav = output_mp4.replace(".mp4", "_emit_audio.wav")
    try:
        _record_video_fp = open(video_path, 'wb')
        _record_audio_fp = _wave.open(audio_wav, 'wb')
        _record_audio_fp.setnchannels(1)
        _record_audio_fp.setsampwidth(2)
        _record_audio_fp.setframerate(_record_audio_sr)
        _record_active = True
        _record_output_mp4 = output_mp4
        _record_video_path = video_path
        _record_audio_wav = audio_wav
        _record_video_count = 0
        _record_audio_count = 0
        _record_started_ts = _t.monotonic()
        _record_video_first_pts = None
        _record_audio_first_pts = None
        print(f"[record] started, duration={duration}s, output={output_mp4}", flush=True)
        import asyncio
        async def _auto_stop():
            await asyncio.sleep(duration)
            await stop_record()
        asyncio.create_task(_auto_stop())
        return output_mp4, None
    except Exception as e:
        print(f"[record] start failed: {e}", flush=True)
        return None, str(e)


async def stop_record():
    """关 fp/wav，再用 ffmpeg mux .h264 + .wav → mp4"""
    global _record_active, _record_video_fp, _record_audio_fp
    global _record_video_count, _record_audio_count, _record_started_ts
    global _record_video_path, _record_audio_wav, _record_output_mp4
    if not _record_active:
        return None, "no active recording"
    output_mp4 = _record_output_mp4
    video_path = _record_video_path
    audio_wav = _record_audio_wav
    try:
        if _record_video_fp:
            _record_video_fp.close()
        if _record_audio_fp:
            _record_audio_fp.close()
        import subprocess as _sp, os as _os
        # pull 端 mux: H.264 + wav → mp4
        cmd = ["ffmpeg", "-y", "-f", "h264", "-i", video_path, "-i", audio_wav,
               "-c:v", "copy", "-c:a", "aac", "-b:a", "128k", "-shortest", output_mp4]
        proc = _sp.Popen(cmd, stdout=_sp.PIPE, stderr=_sp.PIPE, creationflags=0x08000000)
        _, stderr = proc.communicate()
        rc = proc.returncode
        mp4_size = _os.path.getsize(output_mp4) if _os.path.exists(output_mp4) else 0
        print(f"[record] pull mux: video={_record_video_count}NALs, audio={_record_audio_count}pkts, mp4={mp4_size}B rc={rc}", flush=True)
        if rc != 0:
            print(f"[record] pull mux stderr: {stderr.decode(errors='replace')[-400:]}", flush=True)
        else:
            for p in (video_path, audio_wav):
                try: _os.remove(p)
                except OSError: pass
        print(f"[record] file: {output_mp4}", flush=True)
        print(f"[record] emit 端 A-V pts diff 最近一次: {_last_av_pts_diff_ms}ms", flush=True)
    except Exception as e:
        print(f"[record] stop err: {e}", flush=True)
    _record_active = False
    _record_video_fp = None
    _record_audio_fp = None
    _record_video_count = 0
    _record_audio_count = 0
    _record_started_ts = None
    _record_video_path = None
    _record_audio_wav = None
    _record_output_mp4 = None
    return output_mp4, None


def _try_record_video(nal_bytes, pts_ms):
    """video callback：直接 write NAL bytes 到 .h264（零 CPU）"""
    global _record_video_count, _record_video_first_pts
    if _record_video_first_pts is None:
        _record_video_first_pts = pts_ms
        print(f"[record] VIDEO FIRST CALL pts={pts_ms} len={len(nal_bytes)}", flush=True)
    if not _record_active or _record_video_fp is None:
        return
    try:
        _record_video_fp.write(nal_bytes)
        _record_video_count += 1
    except Exception as e:
        if _record_video_count < 5 or _record_video_count % 100 == 0:
            print(f"[record] video write err #{_record_video_count}: {e}", flush=True)


def _try_record_audio(data, pts_ms, is_pcm):
    """audio callback：解码 Opus → 写 PCM 到 wav"""
    global _record_audio_count, _record_audio_first_pts
    if _record_audio_first_pts is None:
        _record_audio_first_pts = pts_ms
        print(f"[record] AUDIO FIRST CALL pts={pts_ms} len={len(data)} pcm={is_pcm}", flush=True)
    if not _record_active or _record_audio_fp is None:
        return
    try:
        if is_pcm:
            n_samples = len(data) // 2
            if n_samples < 2:
                return
            samples = np.frombuffer(data[:n_samples * 2], dtype=np.int16)
            mono = samples[::2]
            _record_audio_fp.writeframes(mono.tobytes())
        else:
            import av as _av
            if _carpo_opus is None:
                _codec = _av.CodecContext.create('opus', 'r')
                _codec.sample_rate = _record_audio_sr
            else:
                _codec = _carpo_opus
            frames = _codec.decode(_av.Packet(data))
            if frames:
                pcm = frames[0].to_ndarray()
                mono = pcm[0] if pcm.ndim == 2 else pcm
                int16 = (mono * 32768).clip(-32768, 32767).astype('int16')
                _record_audio_fp.writeframes(int16.tobytes())
        _record_audio_count += 1
    except Exception as e:
        if _record_audio_count < 5 or _record_audio_count % 100 == 0:
            print(f"[record] audio write err #{_record_audio_count}: {e}", flush=True)


# === emit 端录制已删除，改为内存 A-V pts diff ===
# （数据结构在 _last_av_pts_diff_ms / _carpo_emit_count）


@app.post("/api/debug/record/start")
async def record_start(duration: int = 30):
    """启动 mkv 录制（默认 30 秒）"""
    path, err = _start_record(duration=duration)
    if err:
        return JSONResponse({"ok": False, "error": err}, status_code=400)
    return JSONResponse({"ok": True, "path": path, "duration": duration})


@app.post("/api/debug/record/stop")
async def record_stop():
    """手动停止录制"""
    path, err = await stop_record()
    if err:
        return JSONResponse({"ok": False, "error": err}, status_code=400)
    return JSONResponse({"ok": True, "path": path})


@app.get("/timing")
async def timing_endpoint():
    """返回当前 server 端 timing 快照 (autodl_send.py / 浏览器可拉)"""
    return JSONResponse(_take_timing_snapshot())


@app.get("/events")
async def sse_events():
    """SSE 端点 — 推送 ASR/回复文字 + 延迟数据给前端"""
    queue: asyncio.Queue = asyncio.Queue(maxsize=50)
    _sse_clients.append(queue)

    async def event_stream():
        try:
            while True:
                event = await queue.get()
                yield f"data: {json.dumps(event, ensure_ascii=False)}\n\n"
        except asyncio.CancelledError:
            pass
        finally:
            _sse_clients.remove(queue)

    return StreamingResponse(event_stream(), media_type="text/event-stream")


# === 端到端时延状态 (从 /events SSE 每 1.5s 推一次给浏览器) ===
_timing_report_task: asyncio.Task | None = None


async def _timing_report_loop():
    """后台 loop: 每 0.5s 把 server 端 timing 状态推 SSE"""
    import time as _time
    while True:
        await asyncio.sleep(0.5)
        snap = _take_timing_snapshot()
        if snap:
            await _broadcast({"type": "latency", **snap})


def _take_timing_snapshot() -> dict:
    """抓 server 端 timing 快照, 相对 time.monotonic()

    滚动延迟 (排除 init 延迟):
      - last_decode_to_last_emit = 最近一次 emit - 最近一次 decode
      - last_pull_to_last_decode = 最近一次 decode - 最近一次 pull
    """
    import time as _time
    now = _time.monotonic()
    snap = {"t_now": round(now, 3)}
    # first frame 时间
    if _carpo_first_audio_pull_ts is not None:
        snap["t_pull_audio_first"] = round(_carpo_first_audio_pull_ts, 3)
    if _carpo_first_video_pull_ts is not None:
        snap["t_pull_video_first"] = round(_carpo_first_video_pull_ts, 3)
    if _carpo_first_audio_decode_ts is not None:
        snap["t_decode_audio_first"] = round(_carpo_first_audio_decode_ts, 3)
    if _carpo_first_video_decode_ts is not None:
        snap["t_decode_video_first"] = round(_carpo_first_video_decode_ts, 3)
    if _carpo_first_audio_emit_ts is not None:
        snap["t_emit_audio_first"] = round(_carpo_first_audio_emit_ts, 3)
    if _carpo_first_video_emit_ts is not None:
        snap["t_emit_video_first"] = round(_carpo_first_video_emit_ts, 3)
    # 滚动延迟 (最近一帧的实时原始数据 — 父要看瞬态, 不平均)
    if _audio_decode_emits:
        last_audio = _audio_decode_emits[-1]
        # tuple: (decode_ts, emit_ts, raw_ms, queue_size_before)
        snap["decode_to_emit_audio_ms"] = round(last_audio[2], 1)
        snap["audio_queue_size_before"] = last_audio[3]
        snap["audio_window_size"] = len(_audio_decode_emits)
    if _video_decode_emits:
        last_video = _video_decode_emits[-1]
        snap["decode_to_emit_video_ms"] = round(last_video[2], 1)
        snap["video_window_size"] = len(_video_decode_emits)
    # === monotonic → unix 转换 (跟 235 端 timing 字典对齐) ===
    snap["_server_boot_unix"] = round(_SERVER_BOOT_UNIX, 3)
    if _carpo_first_audio_pull_ts is not None:
        snap["unix_pull_audio_first"] = round(_mono_to_unix(_carpo_first_audio_pull_ts), 3)
    if _carpo_first_video_pull_ts is not None:
        snap["unix_pull_video_first"] = round(_mono_to_unix(_carpo_first_video_pull_ts), 3)
    if _carpo_first_audio_emit_ts is not None:
        snap["unix_emit_audio_first"] = round(_mono_to_unix(_carpo_first_audio_emit_ts), 3)
    if _carpo_first_video_emit_ts is not None:
        snap["unix_emit_video_first"] = round(_mono_to_unix(_carpo_first_video_emit_ts), 3)
    if _last_audio_pull_ts is not None:
        snap["unix_pull_audio_last"] = round(_mono_to_unix(_last_audio_pull_ts), 3)
    if _last_video_pull_ts is not None:
        snap["unix_pull_video_last"] = round(_mono_to_unix(_last_video_pull_ts), 3)
    # 实时跨机器延迟 (235 push timestamp → server pull) - 用 packet 自己的 timestamp 算
    if _last_cross_audio_latency_ms is not None:
        snap["cross_audio_latency_ms"] = round(_last_cross_audio_latency_ms, 1)
    if _last_cross_video_latency_ms is not None:
        snap["cross_video_latency_ms"] = round(_last_cross_video_latency_ms, 1)
    # === emit 端 A-V pts diff (audio.sdk_pts - video.sdk_pts) ===
    if _last_av_pts_diff_ms is not None:
        snap["av_pts_diff_emit_ms"] = round(_last_av_pts_diff_ms, 1)
    snap["audio_count"] = _carpo_frames
    snap["video_count"] = _carpo_video_count
    # A-V sync: audio pts 和 video pts 的差值（ms），正值=audio 比 video 慢
    if _carpo_audio_pts_ms > 0 and _carpo_video_pts_ms > 0:
        snap["av_pts_diff_ms"] = _carpo_audio_pts_ms - _carpo_video_pts_ms
        snap["audio_pts_ms"] = _carpo_audio_pts_ms
        snap["video_pts_ms"] = _carpo_video_pts_ms
    # === perception (VLM) 延迟 ===
    if _perception_mgr:
        snap["vlm_latency"] = round(_perception_mgr.last_vlm_latency, 2)
        snap["vlm_buf_span"] = round(getattr(_perception_mgr, '_last_buf_span', 0), 2)
        snap["vlm_queue"] = round(getattr(_perception_mgr, '_last_queue_wait', 0), 2)
        snap["vlm_total"] = round(getattr(_perception_mgr, '_last_total', 0), 2)
        snap["perception_age"] = round(_time.time() - _perception_mgr.last_perception_ts, 1) if _perception_mgr.last_perception_ts else 0
    return snap


def start_timing_reporter():
    global _timing_report_task
    if _timing_report_task is None or _timing_report_task.done():
        _timing_report_task = asyncio.create_task(_timing_report_loop())
        print("[server] timing reporter started (1.5s interval)")


def _check_remote_avatar():
    """avatar=autodl 时通过 avatarctl.py 检查远端服务，没跑就自动拉起"""
    import subprocess
    avatarctl = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "autodlv2", "avatarctl.py")
    if not os.path.exists(avatarctl):
        print(f"[avatar-check] avatarctl.py not found at {avatarctl}")
        return
    try:
        # status 检查
        r = subprocess.run(["python", avatarctl, "status"], capture_output=True, text=True, timeout=30)
        output = r.stdout.strip()
        print(f"[avatar-check] avatarctl status: {output}")
        if "RUNNING" in output:
            print("[avatar-check] ✅ remote avatar already running")
            return
        # 没跑就 start
        print("[avatar-check] remote avatar not running, starting via avatarctl...")
        r2 = subprocess.run(["python", avatarctl, "start"], capture_output=True, text=True, timeout=120)
        print(f"[avatar-check] avatarctl start: {r2.stdout.strip()}")
        # 等 health check
        import time
        print("[avatar-check] Waiting 30s for models to load...")
        time.sleep(30)
        r3 = subprocess.run(["python", avatarctl, "status"], capture_output=True, text=True, timeout=30)
        print(f"[avatar-check] after start: {r3.stdout.strip()}")
    except Exception as e:
        print(f"[avatar-check] Failed: {e}")


def run():
    """启动服务"""
    global _handler

    # avatar=autodl 时检查远端服务是否在跑，没跑就拉起
    if _runtime_config["avatar_provider"] == "autodl":
        _check_remote_avatar()

    _handler = VoiceChatHandler()
    stream = Stream(
        modality="audio-video",
        mode="send-receive",
        handler=_handler,
        rtc_configuration={"iceServers": [
            {"urls": ["stun:192.144.156.158:3478"]},
            {"urls": ["turn:192.144.156.158:3478"], "username": "xiaoke", "credential": "carpo2026"},
        ]},
        concurrency_limit=10,
    )

    # fastrtc Stream mount 到 FastAPI
    stream.mount(app)

    print(f"[server] voice-chat service starting on port {args.port}")
    print(f"[server] WebRTC endpoint: ws://0.0.0.0:{args.port}/")
    print(f"[server] Voice reply callback: http://0.0.0.0:{args.port}/voice-reply")
    print(f"[server] Health check: http://0.0.0.0:{args.port}/health")

    # Carpo pull: off 模式不启动线程
    if _runtime_config.get('pull_mode', 'off') != 'off':
        def _start_carpo_pull_thread():
            global _carpo_loop
            _carpo_loop = asyncio.new_event_loop()
            asyncio.set_event_loop(_carpo_loop)
            print(f"[carpo] pull thread ready (mode={_runtime_config['pull_mode']}, waiting for trigger)")
            _carpo_loop.run_forever()

        threading.Thread(target=_start_carpo_pull_thread, daemon=True, name="carpo-pull").start()
        print(f"[server] Carpo SDK pull thread started (mode={_runtime_config['pull_mode']})")
    else:
        print("[server] Carpo pull skipped (mode=off)")

    # 启动 timing reporter (后台任务，每 1.5s 推 SSE 给浏览器)
    # 注: 必须在 uvicorn.run() 之后, 此时主线程才有 running event loop
    # 用 on_event("startup") hook 在 FastAPI 内部启动

    @app.on_event("startup")
    async def _on_startup():
        """uvicorn startup 时启动 timing reporter"""
        asyncio.create_task(_timing_report_loop())
        print("[server] timing reporter started (1.5s interval)")
        # 静默 asyncio ProactorBasePipeTransport ConnectionResetError (Windows WebRTC 断连噪音)
        loop = asyncio.get_event_loop()
        def _silence_conn_reset(loop, context):
            exc = context.get('exception')
            if isinstance(exc, ConnectionResetError):
                return  # 静默
            loop.default_exception_handler(context)
        loop.set_exception_handler(_silence_conn_reset)
        print("[server] asyncio exception handler installed (silencing ConnectionResetError)")

    # 自签 SSL — 手机端 WebRTC 需要 HTTPS 才能访问麦克风
    cert_dir = Path(args.workspace) / ".voice-chat" / "certs"
    cert_file = cert_dir / "cert.pem"
    key_file = cert_dir / "key.pem"
    if not cert_file.exists() or not key_file.exists():
        cert_dir.mkdir(parents=True, exist_ok=True)
        # 用 Python 自己生成，不依赖 openssl CLI
        from cryptography import x509
        from cryptography.x509.oid import NameOID
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import rsa
        import datetime as _dt
        key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
        subject = issuer = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "localhost")])
        cert = (
            x509.CertificateBuilder()
            .subject_name(subject)
            .issuer_name(issuer)
            .public_key(key.public_key())
            .serial_number(x509.random_serial_number())
            .not_valid_before(_dt.datetime.utcnow() - _dt.timedelta(days=1))
            .not_valid_after(_dt.datetime.utcnow() + _dt.timedelta(days=365))
            .add_extension(x509.SubjectAlternativeName([
                x509.DNSName("localhost"),
                x509.IPAddress(__import__('ipaddress').ip_address("127.0.0.1")),
            ]), critical=False)
            .sign(key, hashes.SHA256())
        )
        cert_file.write_bytes(cert.public_bytes(serialization.Encoding.PEM))
        key_file.write_bytes(key.private_bytes(
            serialization.Encoding.PEM,
            serialization.PrivateFormat.TraditionalOpenSSL,
            serialization.NoEncryption(),
        ))
        print(f"[server] Self-signed cert generated at {cert_dir}")
    ssl_kwargs = {"ssl_certfile": str(cert_file), "ssl_keyfile": str(key_file)}
    print(f"[server] HTTPS enabled (self-signed)")

    uvicorn.run(app, host="0.0.0.0", port=args.port, log_level="info", **ssl_kwargs)


if __name__ == "__main__":
    try:
        run()
    except KeyboardInterrupt:
        print("\n[server] Shutting down...")
        try:
            if _carpo_puller:
                _carpo_puller.stop()
                print("[server] Carpo pull stopped")
        except Exception:
            pass
        sys.exit(0)
