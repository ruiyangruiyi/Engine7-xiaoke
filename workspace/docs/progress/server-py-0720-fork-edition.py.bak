@app.post("/api/settings")
async def set_settings(request: Request):
    data = await request.json()
    changed = []
    # TTS provider
    if "tts_provider" in data:
        _runtime_config["tts_provider"] = data["tts_provider"]
        changed.append(f"tts_provider={data['tts_provider']}")
    # TTS api_key / model / voice — 凭据类，只存 runtime，不持久化
    for k in ("tts_api_key", "tts_model", "tts_voice"):
        if k in data:
            _runtime_config[k] = data[k]
            changed.append(f"{k}=***" if "key" in k else f"{k}={data[k]}")
    # Avatar provider
    if "avatar_provider" in data:
        _runtime_config["avatar_provider"] = data["avatar_provider"]
        changed.append(f"avatar_provider={data['avatar_provider']}")
    # Avatar TTS (235 侧)
    if "avatar_tts" in data and hasattr(avatar, 'set_tts_provider'):
        avatar.set_tts_provider(data["avatar_tts"])
        _runtime_config["avatar_tts"] = data["avatar_tts"]
        changed.append(f"avatar_tts={data['avatar_tts']}")
    # Avatar image
    if "avatar_image" in data and hasattr(avatar, 'set_cond_image'):
        import asyncio as _aio
        loop = _aio.get_event_loop()
        result = await loop.run_in_executor(None, avatar.set_cond_image, data["avatar_image"])
        _runtime_config["avatar_image"] = data["avatar_image"]
        changed.append(f"avatar_image={data['avatar_image']}")
    # Machine
    if "machine" in data:
        _runtime_config["machine"] = data["machine"]
        if hasattr(avatar, 'machine'):
            avatar.machine = data["machine"]
        changed.append(f"machine={data['machine']}")
    # Pull mode
    if "pull_mode" in data:
        _runtime_config["pull_mode"] = data["pull_mode"]
        changed.append(f"pull_mode={data['pull_mode']}")
    print(f"[settings] Changed: {changed}")
    _save_config()  # 持久化到 workspace
    return JSONResponse({"ok": True, "changed": changed, "config": _runtime_config})

