_MACHINES_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "machines.json")

def _load_runtime_machines():
    """读 machines.json — 跟 /carpo-trigger 用同一个路径"""
    import json as _json
    with open(_MACHINES_PATH, "r", encoding="utf-8") as f:
        return _json.load(f)

def _get_autodl_creds():
    """从 machines.json 读 active 机器的 SSH 凭证"""
    cfg = _load_runtime_machines()
